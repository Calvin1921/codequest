# Local development: copy to .env and generate your own AUTH_SECRET.
# For a fresh disposable demo, prefer npm run demo:setup.
DATABASE_URL="file:./dev.db"
# SQLite is configured in schema.prisma. PostgreSQL also requires schema/migration changes.
AUTH_SECRET=""
# Generate locally with: openssl rand -hex 32 (never commit the result).
AUTH_URL="http://localhost:3000"

# Optional OAuth providers; credentials registration works without these.
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Upstash: registration and profile/account actions only.
# Unconfigured means no rate limiting. Login and code execution are not covered.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
