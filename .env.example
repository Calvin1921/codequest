# =============================================================================
# CodeQuest Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Only DATABASE_URL and AUTH_SECRET are required for local development.
# All other variables are optional — features degrade gracefully when unset.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# SQLite for local development. For production, use a PostgreSQL connection string:
# DATABASE_URL="postgresql://user:password@host:5432/codequest?sslmode=require"
DATABASE_URL="file:./dev.db"

# -----------------------------------------------------------------------------
# Auth.js (NextAuth v5)
# -----------------------------------------------------------------------------
# Required. Generate a random secret with: openssl rand -hex 32
AUTH_SECRET="your-auth-secret-here-generate-with-openssl-rand-hex-32"

# The canonical URL of the app. Set to your deployment URL in production.
AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# OAuth Providers (optional)
# -----------------------------------------------------------------------------
# GitHub: https://github.com/settings/developers -> New OAuth App
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google: https://console.cloud.google.com/apis/credentials -> Create OAuth Client
# Callback URL: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Upstash Redis (optional)
# -----------------------------------------------------------------------------
# Used for sliding-window rate limiting on auth, posts, and API endpoints.
# Rate limiting is silently skipped when these are not configured.
# Sign up at: https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -----------------------------------------------------------------------------
# Sentry (optional)
# -----------------------------------------------------------------------------
# Error tracking and performance monitoring. Only active in production builds.
# Create a project at: https://sentry.io
SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# -----------------------------------------------------------------------------
# Vercel (optional)
# -----------------------------------------------------------------------------
# Automatically set by Vercel on deployment. Used for constructing absolute URLs.
VERCEL_URL=""
